#!/usr/bin/env bash
# Development: Rails (API) on :3000 and Vite (the React app, with hot reload) on
# :5173, which forwards /api to Rails. Open http://127.0.0.1:5173.
# Reads settings such as GROQ_API_KEY from .env in the repository root.
# Other ports: RAILS_PORT=3100 VITE_PORT=5180 bin/dev
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

RAILS_PORT=${RAILS_PORT:-3000}
export RAILS_URL="http://127.0.0.1:${RAILS_PORT}"

trap 'kill 0' EXIT INT TERM
(cd Backend && PORT="$RAILS_PORT" bin/rails server -b 127.0.0.1) &
npx vite --host 127.0.0.1 --port "${VITE_PORT:-5173}" --strictPort &
wait
