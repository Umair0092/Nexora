# Copy to .env.docker for `docker compose up`, or to .env for `bin/dev`. Never commit the real file.

# Database (Docker)
NEXORA_DATABASE_PASSWORD=change-me
POSTGRES_PASSWORD=change-me          # must match NEXORA_DATABASE_PASSWORD
DATABASE_URL=postgres://nexora:change-me@db:5432/nexora_production
# For bin/dev against a local Postgres instead:
# DATABASE_URL=postgres://localhost:5432/nexora_development

# Rails
RAILS_ENV=production
RAILS_MASTER_KEY=
JWT_SECRET=                          # signs sign-in tokens; generate with: openssl rand -hex 48
APP_URL=http://127.0.0.1:5001        # public address of the app; used in links inside emails
# RAILS_FORCE_SSL=true               # behind HTTPS in production

# AI: interviewer, scoring, CV reading and transcription
GROQ_API_KEY=                        # free at console.groq.com
# Any other OpenAI-compatible provider for chat (transcription stays on Groq):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MAX_RETRIES=6                  # retries on rate limits (free tiers allow ~8k tokens a minute)
# LIVE_INTERVIEW_TTL_MINUTES=180     # unfinished interviews are deleted after this long idle
# Interviewer voice (Groq Orpheus; accept its terms once at console.groq.com/playground?model=canopylabs%2Forpheus-v1-english).
# Without it, browsers read questions with their own best voice.
# TTS_VOICE=hannah                   # also: autumn, diana, austin, daniel, troy
# TTS_MODEL=canopylabs/orpheus-v1-english

# Email (password resets, email confirmation, practice reminders). Any SMTP provider
# works, e.g. Brevo or Resend free tiers, or a Gmail app password. Leave SMTP_ADDRESS
# empty to write emails to Backend/tmp/mails instead (links are also logged).
MAIL_FROM=Nexora <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Google (optional): "Continue with Google" sign-in, and interviews with a Google Meet link.
# Create an OAuth client (Web application) at console.cloud.google.com, enable the Google
# Calendar API, and add both redirect URIs: APP_URL + /api/v1/auth/google/callback and
# APP_URL + /api/v1/calendar/google/callback.
# Without these, interviews use any video link and invites go out as calendar files.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meeting notetaker (optional): a bot that joins Google Meet, Zoom or Teams interviews,
# records the captions and lets Nexora write the minutes. Uses Recall.ai (recall.ai).
# Without it, upload the call's recording after the interview for the same minutes.
RECALL_API_KEY=
# RECALL_REGION=us-west-2            # or us-east-1, eu-central-1, ap-northeast-1 (where your Recall account is)

# Billing (optional). Without STRIPE_SECRET_KEY every company gets everything with no limits.
# With it: Free (1 open job, 25 candidates a month) and Team (Stripe Checkout, the price below).
# Add a webhook in the Stripe dashboard to APP_URL + /api/v1/billing/webhook for
# checkout.session.completed, customer.subscription.* and invoice.payment_failed.
STRIPE_SECRET_KEY=                   # sk_test_... while trying it out
STRIPE_PRICE_TEAM=                   # price_... for the Team plan's monthly price
STRIPE_WEBHOOK_SECRET=               # whsec_... from that webhook
# SALES_EMAIL=sales@example.com      # "Contact us" for the Business plan (defaults to MAIL_FROM)

# Optional public tunnel: docker compose --profile tunnel up
NGROK_AUTHTOKEN=
