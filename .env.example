# Copy to .env.docker and fill in. Never commit the real file.

# Database
NEXORA_DATABASE_PASSWORD=change-me
POSTGRES_PASSWORD=change-me          # must match NEXORA_DATABASE_PASSWORD
DATABASE_URL=postgres://nexora:change-me@db:5432/nexora_production

# Gateway
PORT=5000
NODE_ENV=production
RAILS_BACKEND_URL=http://rails:3000
AI_RESUME_URL=http://ai-resume:8000
AI_QUIZ_URL=http://ai-feedback:8001
AI_NONVERBAL_URL=http://ai-nonverbal:8765

# Auth — Rails signs JWTs with this, the gateway verifies them. Generate with: openssl rand -hex 48
JWT_SECRET=

# Rails
RAILS_ENV=production
RAILS_MASTER_KEY=
CORS_ORIGINS=http://localhost:5001
APP_URL=http://127.0.0.1:5001     # public address of the app; used in links inside emails

# Email (password resets, email confirmation, practice reminders). Any SMTP provider
# works, e.g. Brevo or Resend free tiers, or a Gmail app password. Leave SMTP_ADDRESS
# empty to write emails to Backend/tmp/mails instead (links are also logged).
MAIL_FROM=Nexora <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# AI services (see server/services/ai/.env.example for the full list)
GROQ_API_KEY=                 # free at console.groq.com; powers the AI interviewer and transcription
# LLM_BASE_URL= / LLM_API_KEY= / LLM_MODEL=   # optional: any other OpenAI-compatible provider

# Optional public tunnel: docker compose --profile tunnel up
NGROK_AUTHTOKEN=
