# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values
#
#   cp .env.example .env
#
# Both AI microservices load this single file:
#   resumeaiservice    → runs on port 8000  (resume parsing + AI interview)
#   interview_feedback → runs on port 8001  (CSV quiz + AI evaluation)
#
# Each service uses its own prefixed variables so you can point them at
# different models or API keys if needed.
# ─────────────────────────────────────────────────────────────────────────────


# ── resumeaiservice ───────────────────────────────────────────────────────────

# Your OpenRouter API key  →  https://openrouter.ai/keys
RESUME_OPENROUTER_API_KEY=

# OpenRouter base URL (leave as-is unless self-hosting)
RESUME_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use — any OpenRouter-supported model ID
# Default: google/gemini-2.0-flash-001
RESUME_GEMINI_MODEL=google/gemini-2.0-flash-001

# Minutes before an idle interview session is removed from memory
RESUME_SESSION_TTL_MINUTES=60

# Maximum PDF resume upload size in megabytes
RESUME_MAX_FILE_SIZE_MB=10

# Groq API key for Whisper voice transcription  →  https://console.groq.com/keys
# Leave blank to disable the /api/v1/transcribe endpoint
GROQ_API_KEY=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


# ── interview_feedback ────────────────────────────────────────────────────────

# Your OpenRouter API key (can be the same as above or a different one)
FEEDBACK_OPENROUTER_API_KEY=

# OpenRouter base URL (leave as-is unless self-hosting)
FEEDBACK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use — any OpenRouter-supported model ID
# Default: google/gemini-2.0-flash-001
FEEDBACK_GEMINI_MODEL=google/gemini-2.0-flash-001

# Minutes before an idle quiz session is removed from memory
FEEDBACK_SESSION_TTL_MINUTES=60
