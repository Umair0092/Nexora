# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values
#
#   cp .env.example .env
#
# The AI microservices load this single file:
#   resumeaiservice    → runs on port 8000  (resume parsing + AI interview)
#   interview_feedback → runs on port 8001  (CSV quiz + AI evaluation)
#   nonverbal_cues     → runs on port 8765  (MediaPipe over WebSocket; reads
#                        its NONVERBAL_* vars from the process environment)
#
# Each service uses its own prefixed variables so you can point them at
# different models or API keys if needed.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM provider (both services) ──────────────────────────────────────────────

# Groq API key  →  https://console.groq.com/keys  (free tier)
# Used for the AI interviewer, evaluation, CV parsing AND Whisper transcription.
GROQ_API_KEY=

# Optional: use any other OpenAI-compatible provider for chat instead of Groq.
# Examples: https://openrouter.ai/api/v1, https://generativelanguage.googleapis.com/v1beta/openai/,
#           http://host.docker.internal:11434/v1 (Ollama). Leave unset to use Groq.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=                 # defaults to GROQ_API_KEY
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MAX_RETRIES=6          # retries after rate-limit errors, waiting as long as the provider asks


# ── Session storage (both services) ──────────────────────────────────────────

# In-progress interviews are stored in Postgres (table ai_sessions, created
# automatically) when DATABASE_URL is set, so they survive restarts. Without it
# they live in memory. Docker Compose passes the app's DATABASE_URL.
# DATABASE_URL=postgres://nexora:password@localhost:5432/nexora_development
# AI_SESSION_STORE=memory        # force in-memory storage


# ── resumeaiservice ───────────────────────────────────────────────────────────

# Minutes before an idle interview session is removed
RESUME_SESSION_TTL_MINUTES=180

# Maximum PDF resume upload size in megabytes
RESUME_MAX_FILE_SIZE_MB=10

# Maximum audio upload size for /api/v1/transcribe in megabytes (larger → 413)
RESUME_MAX_AUDIO_MB=15

# Max concurrently active interview sessions per user (X-User-Id header set by
# the gateway). Starting one more evicts that user's oldest session.
RESUME_MAX_SESSIONS_PER_OWNER=5


# ── interview_feedback ────────────────────────────────────────────────────────

# Minutes before an idle quiz session is removed from memory
FEEDBACK_SESSION_TTL_MINUTES=180

# Max concurrently active quiz sessions per user (X-User-Id header set by the
# gateway). Starting one more evicts that user's oldest session.
FEEDBACK_MAX_SESSIONS_PER_OWNER=5


# ── nonverbal_cues ────────────────────────────────────────────────────────────

# Comma-separated CORS origins for the HTTP endpoints.
# Default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
NONVERBAL_CORS_ORIGINS=

# Comma-separated Origin allow-list for the /ws/nonverbal WebSocket handshake.
# Leave blank to disable the Origin check.
NONVERBAL_ALLOWED_ORIGINS=
